; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Root Cafe"
run/main_scene="uid://d20agtqda16r6"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/visuals/icon.svg"

[autoload]

SignalHub="*uid://b8pg0jfwkjx6k"
CupContents="*uid://cgjb3s8iye1kk"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://resources/": "orange",
"res://scenes/": "teal",
"res://scripts/": "yellow"
}

[global_group]

draggable=""

[layer_names]

2d_physics/layer_1="Environment"
2d_physics/layer_2="Ingredients"
2d_physics/layer_3="ActiveIngredient"
2d_physics/layer_4="Cup"
2d_physics/layer_5="IngredientReceiver"

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity=1200.0

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.14332023, 0.44155413, 0.4573518, 1)
